#!/bin/sh
# setup — wire biscuit-harness into ~/.claude
#
# Idempotent: safe to re-run any time. Never copies files — agents and skills
# are symlinked, hooks are registered by path, so `git pull` updates everything.
#
# Usage:
#   ./setup           personal install
#   ./setup --team    personal install + print team-mode next steps
#   ./setup --check   print what is registered, the clone state, the claude
#                     binary the extractor will use and its working flag set
#
# Env:
#   CLAUDE_DIR   override ~/.claude (used by tests)
set -e

HARNESS_DIR="$(cd "$(dirname "$0")" && pwd)"
CLAUDE_DIR="${CLAUDE_DIR:-$HOME/.claude}"
MODE="personal"
[ "$1" = "--team" ] && MODE="team"
[ "$1" = "--check" ] && MODE="check"

command -v python3 >/dev/null 2>&1 || {
  echo "setup: python3 is required (macOS: xcode-select --install)" >&2
  exit 1
}

if [ "$MODE" = "check" ]; then
  echo "harness:  $HARNESS_DIR"
  (cd "$HARNESS_DIR" && echo "clone:    $(git rev-parse --abbrev-ref HEAD 2>/dev/null) @ $(git rev-parse --short HEAD 2>/dev/null), $(git status --porcelain 2>/dev/null | wc -l | tr -d ' ') uncommitted change(s)")
  python3 - "$HARNESS_DIR" "$CLAUDE_DIR/settings.json" <<'PY'
import json, os, sys
harness, path = sys.argv[1], sys.argv[2]
sys.path.insert(0, os.path.join(harness, "hooks"))
from _project_name import ledger_status_counts, looks_like_harness_rules
try:
    hooks = json.load(open(path)).get("hooks", {})
except Exception:
    hooks = {}
print("hooks:")
for ev, entries in hooks.items():
    for e in entries:
        for h in e.get("hooks", []):
            cmd = h.get("command", "")
            if harness in cmd or cmd.rsplit("/", 1)[-1] in ("learn-on-stop.sh",):
                extra = f" timeout={h['timeout']}" if "timeout" in h else ""
                print(f"  {ev:<13} {cmd.rsplit('/', 1)[-1]}{extra}" + (f" matcher={e['matcher']}" if e.get("matcher") else ""))
legacy = os.path.join(os.path.dirname(path), "rules")
n = 0
try:
    for f in os.listdir(legacy):
        if f.endswith(".md"):
            try:
                n += looks_like_harness_rules(open(os.path.join(legacy, f)).read())
            except OSError:
                pass
except OSError:
    pass
print(f"legacy harness-style ~/.claude/rules/*.md files (loaded into EVERY project by Claude Code): {n}")
print("learn-queue:", json.dumps(ledger_status_counts()))
PY
  echo "extractor probe (cached per binary version; 'hooks/learn-extract.sh --probe --force' makes a fresh call):"
  "$HARNESS_DIR/hooks/learn-extract.sh" --probe 2>&1 | sed 's/^/  /'
  exit 0
fi

mkdir -p "$CLAUDE_DIR/agents" "$CLAUDE_DIR/skills"
chmod +x "$HARNESS_DIR"/hooks/*.sh "$HARNESS_DIR"/bin/* 2>/dev/null || true

# 1. agents/*.md → ~/.claude/agents/ (symlink)
AGENTS=0
for f in "$HARNESS_DIR"/agents/*.md; do
  [ -e "$f" ] || continue
  base="$(basename "$f")"
  [ "$base" = "README.md" ] && continue
  ln -sf "$f" "$CLAUDE_DIR/agents/$base"
  AGENTS=$((AGENTS + 1))
done

# 2. skills/<name>/ → ~/.claude/skills/<name> (symlink, only dirs with SKILL.md)
SKILLS=0
for d in "$HARNESS_DIR"/skills/*/; do
  [ -f "${d}SKILL.md" ] || continue
  name="$(basename "$d")"
  target="$CLAUDE_DIR/skills/$name"
  if [ -e "$target" ] && [ ! -L "$target" ]; then
    echo "  ! skill '$name': $target already exists and is not a symlink — skipped" >&2
    continue
  fi
  ln -sfn "${d%/}" "$target"
  SKILLS=$((SKILLS + 1))
done

# 3. hooks + guardrail deny rules → ~/.claude/settings.json
python3 - "$HARNESS_DIR" "$CLAUDE_DIR/settings.json" <<'PY'
import json, os, re, sys

harness, path = sys.argv[1], sys.argv[2]

try:
    with open(path) as f:
        settings = json.load(f)
except FileNotFoundError:
    settings = {}
except json.JSONDecodeError:
    sys.exit(f"setup: {path} is not valid JSON — fix it and re-run")

hooks = settings.setdefault("hooks", {})

# Every hook filename the harness ever registered. Used for "already
# installed" detection (deny rules are added on the first install only) and
# so a retired hook's entry can be recognised as ours and removed.
HOOK_BASENAMES = {
    "auto-update.sh", "check-types.sh", "check-type-dup.sh",
    "learn-on-stop.sh", "learn-recall.sh", "learn-extract.sh",
    "metrics-on-end.sh",
}
RETIRED = {"learn-on-stop.sh"}  # v4: capture happens only at SessionEnd

already_installed = any(
    h.get("command", "").rsplit("/", 1)[-1] in HOOK_BASENAMES
    for ev in hooks.values() for e in ev for h in e.get("hooks", [])
)


def ensure_hook(event, matcher, command, timeout=None):
    # Dedupe by script basename, not full path: a moved/re-cloned harness
    # repoints the existing entry instead of registering a duplicate. The
    # harness only ever edits the entries it created (basename = ours).
    base = command.rsplit("/", 1)[-1]
    entries = hooks.setdefault(event, [])
    for e in entries:
        for h in e.get("hooks", []):
            cmd = h.get("command", "")
            if cmd.rsplit("/", 1)[-1] == base:
                changed = False
                if cmd != command:
                    h["command"] = command
                    changed = True
                if timeout is not None and h.get("timeout") != timeout:
                    h["timeout"] = timeout
                    changed = True
                return changed  # a timeout the harness did not write is left alone
    hook = {"type": "command", "command": command}
    if timeout is not None:
        hook["timeout"] = timeout
    entry = {"hooks": [hook]}
    if matcher:
        entry["matcher"] = matcher
    entries.append(entry)
    return True


def remove_hook(event, base):
    """Remove only hook objects whose command basename is a harness filename;
    a user's own entry on the same event is never touched."""
    removed = False
    entries = hooks.get(event) or []
    for e in entries:
        hs = e.get("hooks", [])
        keep = [h for h in hs if h.get("command", "").rsplit("/", 1)[-1] != base]
        if len(keep) != len(hs):
            e["hooks"] = keep
            removed = True
    hooks[event] = [e for e in entries if e.get("hooks")]
    if not hooks[event]:
        del hooks[event]
    return removed


added = []
for base in RETIRED:
    for ev in list(hooks.keys()):
        if remove_hook(ev, base):
            added.append(f"{ev}: {base[:-3]} (removed — retired)")
if ensure_hook("SessionStart", None, f"{harness}/hooks/auto-update.sh"):
    added.append("SessionStart: auto-update")
if ensure_hook("PostToolUse", "Edit|Write|MultiEdit", f"{harness}/hooks/check-types.sh"):
    added.append("PostToolUse: check-types")
if ensure_hook("PostToolUse", "Edit|Write|MultiEdit", f"{harness}/hooks/check-type-dup.sh"):
    added.append("PostToolUse: check-type-dup")
if ensure_hook("SessionStart", None, f"{harness}/hooks/learn-recall.sh"):
    added.append("SessionStart: learn-recall")
# SessionEnd's default budget is 1.5 s; both hooks finish in well under a
# second, the 10 s is a ceiling for slow (network-mounted) folders.
if ensure_hook("SessionEnd", None, f"{harness}/hooks/learn-extract.sh", timeout=10):
    added.append("SessionEnd: learn-extract")
if ensure_hook("SessionEnd", None, f"{harness}/hooks/metrics-on-end.sh", timeout=10):
    added.append("SessionEnd: metrics-on-end")

if not already_installed:
    deny = settings.setdefault("permissions", {}).setdefault("deny", [])
    for rule in [
        "Bash(git push --force:*)",
        "Bash(git push -f:*)",
        "Bash(rm -rf /:*)",
        "Bash(rm -rf ~:*)",
        "Bash(rm -rf $HOME:*)",
    ]:
        if rule not in deny:
            deny.append(rule)
            added.append(f"deny: {rule}")

with open(path, "w") as f:
    json.dump(settings, f, indent=2)
    f.write("\n")

for a in added:
    print(f"  + {a}")
if not added:
    print("  = settings.json already up to date")

# Re-arm extraction after configuration errors: clear the pause counters and
# let terminal jobs be retried once (the configuration presumably changed).
sys.path.insert(0, os.path.join(harness, "hooks"))
from _project_name import QUEUE_DIR, looks_like_harness_rules
claude_dir = os.path.dirname(path)
try:
    for f in os.listdir(QUEUE_DIR):
        p = os.path.join(QUEUE_DIR, f)
        if f.startswith(".terminal-"):
            os.remove(p)
            print("  + re-armed paused extraction store")
        elif f.endswith(".json") and not f.startswith("caps-"):
            try:
                rec = json.load(open(p))
                if rec.get("status") == "terminal":
                    rec.update({"status": "failed", "retries": 0, "rearmed": True})
                    with open(p, "w") as fh:
                        json.dump(rec, fh)
                    print(f"  + re-armed terminal extraction job {f}")
            except Exception:
                pass
except OSError:
    pass

# v3 leftovers: harness-shaped files in ~/.claude/rules/ are loaded by Claude
# Code into EVERY project on this machine. Notice only — moving the user's
# memory is never automatic.
legacy = os.path.join(claude_dir, "rules")
n = 0
try:
    for f in os.listdir(legacy):
        if f.endswith(".md"):
            try:
                n += looks_like_harness_rules(open(os.path.join(legacy, f)).read())
            except OSError:
                pass
except OSError:
    pass
if n:
    print(f"  ! {n} harness-style rules file(s) in {legacy} are loaded into EVERY project; "
          f"run {harness}/bin/migrate-legacy-rules to move them into per-folder stores")
PY

echo ""
echo "✅ biscuit-harness installed ($AGENTS agents, $SKILLS skills linked)"
echo "   Updates arrive automatically: every session start pulls the latest (1h throttle)."

if [ "$MODE" = "team" ]; then
  echo ""
  echo "Team mode — next, inside each project repo, run:"
  echo "   $HARNESS_DIR/bin/team-init required   # or 'optional'"
  echo "   git add .claude/ && git commit -m 'require biscuit-harness for AI-assisted work'"
fi
